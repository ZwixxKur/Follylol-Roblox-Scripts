-- серверные команды
local function sendAdmin(action, target, ...)
	local re = findRemote(CONFIG.AdminRemote, "RemoteEvent")
	if not re then
		notify("Нет серверной части", "Создай RemoteEvent «" .. CONFIG.AdminRemote .. "» в ReplicatedStorage и обработчик на сервере (пример — в конце скрипта).", true)
		return
	end
	re:FireServer(action, target, ...)
	notify("Команда отправлена", action .. " → " .. target.Name)
end

local function playerNames(except)
	local names = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= except then table.insert(names, p.Name) end
	end
	table.sort(names, function(a, b) return a:lower() < b:lower() end)
	return names
end

-- персонаж
local function onCharacter(char)
	Char, Hum, Root = char, nil, nil
	flyLV, flyAO, flyAtt = nil, nil, nil
	table.clear(noclipParts)
	local hum = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if char ~= LocalPlayer.Character then return end
	Hum, Root = hum, root
	if Hum then
		Defaults.WalkSpeed = Hum.WalkSpeed
		Defaults.JumpPower = Hum.JumpPower
		Defaults.UseJumpPower = Hum.UseJumpPower
	end
	if State.Fly then startFly() end
end

