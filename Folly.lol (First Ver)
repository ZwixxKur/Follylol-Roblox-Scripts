	corner(bar, 2)
	accentGradient(bar, 90)
	label(header, title, 13, W.B, "Text", {Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -14, 1, 0)})

	local sep = new("Frame", {Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = WHITE, LayoutOrder = 1, Parent = card})
	accentGradient(sep).Transparency = NumberSequence.new(0.25, 1)
	new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 4), LayoutOrder = 2, Parent = card})

	-- пункт подраздела в сайдбаре
	local item = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = index, Parent = self.Subs})
	local indicator = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(2, 14), BackgroundColor3 = WHITE, BackgroundTransparency = 1, Parent = item})
	corner(indicator, 1)
	accentGradient(indicator, 90)
	local itemLabel = label(item, title, 12, W.R, "SubText", {Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -14, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd})

	local section = setmetatable({Card = card, Order = 10, Category = self, Indicator = indicator, ItemLabel = itemLabel}, Section)
	table.insert(self.Sections, section)

	item.MouseEnter:Connect(function()
		if self.ActiveSection ~= section then paint(itemLabel, {TextColor3 = "Text"}) end
	end)
	item.MouseLeave:Connect(function()
		if self.ActiveSection ~= section then paint(itemLabel, {TextColor3 = "SubText"}) end
	end)
	item.MouseButton1Click:Connect(function()
		selectCategory(self, true)
		self:ScrollTo(section)
	end)

	if index == 1 then self:SetActiveSection(section) end
	if self.Expanded then self.Subs.Visible = true end
	return section
end

function selectCategory(cat, keepExpanded)
	if ActiveCategory == cat then
		if not keepExpanded then cat:SetExpanded(not cat.Expanded) end
		return
	end
	if ActiveCategory then ActiveCategory:SetActive(false) end
	ActiveCategory = cat
	cat:SetActive(true)
	PageTitle.Text = cat.Name
	PageSub.Text = cat.Subtitle
	PageTitle.TextTransparency, PageSub.TextTransparency = 1, 1
	tween(PageTitle, 0.3, {TextTransparency = 0})
	tween(PageSub, 0.45, {TextTransparency = 0})
end

