		label(b, opt.Name, 13, W.B, "OnAccent", {Size = UDim2.fromScale(1, 1), TextXAlignment = CENTER, TextTruncate = Enum.TextTruncate.AtEnd})
	else
		base = 0.25
		paint(b, {BackgroundColor3 = "Track"})
		s = stroke(b, "Stroke", "StrokeT")
		label(b, opt.Name, 12, W.M, "Text", {Size = UDim2.fromScale(1, 1), TextXAlignment = CENTER, TextTruncate = Enum.TextTruncate.AtEnd})
	end
	b.BackgroundTransparency = base
	local hoverT = opt.Primary and 0.15 or 0
	local hovered = false
	b.MouseEnter:Connect(function()
		hovered = true
		tween(b, 0.15, {BackgroundTransparency = hoverT})
		if s then paint(s, {Color = "Accent"}) end
	end)
	b.MouseLeave:Connect(function()
		hovered = false
		tween(b, 0.2, {BackgroundTransparency = base})
		if s then paint(s, {Color = "Stroke"}) end
	end)
	b.MouseButton1Click:Connect(function()
		b.BackgroundTransparency = 0.5
		tween(b, 0.25, {BackgroundTransparency = hovered and hoverT or base})
		fire(opt.Callback)
	end)
	return b
end

-- Button({Name, Callback, Primary})
function Section:Button(opt)
	local wrap = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = self:_next(), Parent = self.Card})
	local b = makeButton(wrap, opt)
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.Position = UDim2.fromScale(0.5, 0.5)
	b.Size = UDim2.new(1, -8, 0, 32)
	return {Button = b}
end

-- Buttons({ {Name, Callback, Primary}, ... }) — несколько кнопок в одну строку
function Section:Buttons(list)
	local wrap = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = self:_next(), Parent = self.Card})
	local n = #list
	for i, opt in ipairs(list) do
		local b = makeButton(wrap, opt)
		b.AnchorPoint = Vector2.new(0, 0.5)
		b.Position = UDim2.new((i - 1) / n, 4, 0.5, 0)
		b.Size = UDim2.new(1 / n, -8, 0, 32)
	end
end

-- Paragraph(text) -> {Set(text)}; поддерживает RichText
function Section:Paragraph(text)
	local l = label(self.Card, text, 12, W.R, "SubText", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, TextWrapped = true, RichText = true, LayoutOrder = self:_next()})
