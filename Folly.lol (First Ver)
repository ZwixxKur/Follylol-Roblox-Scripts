local function newCategory(name, subtitle)
	local entry = new("Frame", {Name = name, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, LayoutOrder = #Categories + 1, Parent = Nav})
	new("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = entry})

	local btn = new("TextButton", {Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, LayoutOrder = 0, Parent = entry})
	paint(btn, {BackgroundColor3 = "Card"})
	corner(btn, 10)
	local btnStroke = stroke(btn, "Stroke", 1)

	local bullet = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.5, 0), Size = UDim2.fromOffset(8, 8), BackgroundTransparency = 1, Parent = btn})
	paint(bullet, {BackgroundColor3 = "Accent"})
	corner(bullet, 4)
	local bulletStroke = stroke(bullet, "Muted", 0, 1.5)

	local nameLabel = label(btn, name, 13, W.S, "Text", {Position = UDim2.fromOffset(32, 0), Size = UDim2.new(1, -60, 1, 0)})
	local chev = chevron(btn, UDim2.new(1, -18, 0.5, 0), "SubText")

	local subs = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, Visible = false, LayoutOrder = 1, Parent = entry})
	new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Parent = subs})
	padding(subs, 2, 0, 6, 16)

	local page = new("ScrollingFrame", {
		Name = name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = AUTO_Y,
		ScrollBarThickness = 3,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = Pages,
	})
	paint(page, {ScrollBarImageColor3 = "Accent"})
	padding(page, 6, 12, 14, 6)

	local cols = {}
	for i = 1, 2 do
		local col = new("Frame", {BackgroundTransparency = 1, Position = UDim2.new((i - 1) * 0.5, (i - 1) * 6, 0, 0), Size = UDim2.new(0.5, -6, 0, 0), AutomaticSize = AUTO_Y, Parent = page})
		new("UIListLayout", {Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = col})
		cols[i] = col
	end

	local cat = setmetatable({
		Name = name,
		Subtitle = subtitle or "",
		Btn = btn,
		BtnStroke = btnStroke,
		Bullet = bullet,
		BulletStroke = bulletStroke,
		NameLabel = nameLabel,
		Chev = chev,
		Subs = subs,
		Page = page,
		Cols = cols,
		Sections = {},
		Active = false,
		Expanded = false,
		Spy = true,
	}, Category)

	btn.MouseEnter:Connect(function()
		if not cat.Active then tween(btn, 0.15, {BackgroundTransparency = 0.8}) end
	end)
	btn.MouseLeave:Connect(function()
		if not cat.Active then tween(btn, 0.2, {BackgroundTransparency = 1}) end
	end)
	btn.MouseButton1Click:Connect(function() selectCategory(cat) end)

	-- подсветка подраздела в сайдбаре по мере прокрутки
	page:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		if not cat.Spy or #cat.Sections == 0 then return end
		local scale = WinScale.Scale
		local top = page.AbsolutePosition.Y + 40 * scale
		local atBottom = page.CanvasPosition.Y >= (page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y) / scale - 2
		local best, bestY
		for _, s in ipairs(cat.Sections) do
			local y = s.Card.AbsolutePosition.Y
			if atBottom then
				if not bestY or y > bestY then best, bestY = s, y end
			elseif y <= top and (not bestY or y > bestY) then
				best, bestY = s, y
			end
		end
		best = best or cat.Sections[1]
		if best ~= cat.ActiveSection then cat:SetActiveSection(best) end
	end)

	table.insert(Categories, cat)
	onTheme(function() cat:Refresh() end)
	return cat
end

function Category:Refresh()
	local a = self.Active
	self.Btn.BackgroundTransparency = a and Theme.CardT or 1
	self.BtnStroke.Transparency = a and math.max(0, Theme.StrokeT - 0.15) or 1
	self.Bullet.BackgroundTransparency = a and 0 or 1
	paint(self.BulletStroke, {Color = a and "Accent" or "Muted"})
	setText(self.NameLabel, a and W.B or W.S)
end

function Category:SetExpanded(v)
	self.Expanded = v
	self.Subs.Visible = v and #self.Sections > 0
	self.Chev:Set(v)
end

function Category:SetActive(v)
	self.Active = v
	self.Page.Visible = v
	if v then
		self.Page.Position = UDim2.fromOffset(0, 12)
		tween(self.Page, 0.3, {Position = UDim2.fromOffset(0, 0)})
	end
	self:SetExpanded(v)
	self:Refresh()
end

function Category:SetActiveSection(section)
	self.ActiveSection = section
	for _, s in ipairs(self.Sections) do
		local a = s == section
		s.Indicator.BackgroundTransparency = a and 0 or 1
		paint(s.ItemLabel, {TextColor3 = a and "Text" or "SubText"})
		setText(s.ItemLabel, a and W.M or W.R)
	end
end

function Category:ScrollTo(section)
	self:SetActiveSection(section)
	self.Spy = false
	task.defer(function()
		local page = self.Page
		local scale = WinScale.Scale
		local y = (section.Card.AbsolutePosition.Y - page.AbsolutePosition.Y) / scale + page.CanvasPosition.Y - 6
		local maxY = math.max(0, (page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y) / scale)
		tween(page, 0.4, {CanvasPosition = Vector2.new(0, math.clamp(y, 0, maxY))}).Completed:Once(function()
			self.Spy = true
		end)
	end)
end

function Category:Section(title, side)
