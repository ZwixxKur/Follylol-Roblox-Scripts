local function findRemote(name, class)
	local r = ReplicatedStorage:FindFirstChild(name)
	if r and r:IsA(class) then return r end
	return nil
end

local Storage = {}

function Storage.load()
	local rf = findRemote(CONFIG.SettingsRemote, "RemoteFunction")
	if not rf then return end
	local data, done = nil, false
	task.spawn(function()
		local ok, res = pcall(rf.InvokeServer, rf, "load")
		if ok then data = res end
		done = true
	end)
	local waited = 0
	while not done and waited < 3 do waited += task.wait() end
	if type(data) ~= "table" then return end
	for k, v in pairs(data) do
		if Settings[k] ~= nil and type(v) == type(Settings[k]) then Settings[k] = v end
	end
end

local saveQueued = false
function Storage.save()
	if saveQueued then return end
	saveQueued = true
	task.delay(1, function()
		saveQueued = false
		local rf = findRemote(CONFIG.SettingsRemote, "RemoteFunction")
		if rf then pcall(rf.InvokeServer, rf, "save", Settings) end
	end)
end

Storage.load()

