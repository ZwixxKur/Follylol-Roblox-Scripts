local HighlightsMap, TagsMap = {}, {}
local TagFolder = new("Folder", {Name = "FollyLolTags", Parent = PlayerGui})

local function clearPlayerVisuals(plr)
	if HighlightsMap[plr] then
		HighlightsMap[plr]:Destroy()
