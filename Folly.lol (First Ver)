function Section:Toggle(opt)
	local row = self:_row(36)
	label(row, opt.Name, 13, W.R, "Text", {Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -70, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd})

	local switch = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(42, 22), Parent = row})
	paint(switch, {BackgroundColor3 = "Track"})
	corner(switch, 11)
	stroke(switch, "Stroke", "StrokeT")
	local fill = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 1, Parent = switch})
	corner(fill, 11)
	accentGradient(fill)
	local knob = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(16, 16), ZIndex = 2, Parent = switch})
	paint(knob, {BackgroundColor3 = "Knob"})
	corner(knob, 8)

	local el = {Value = false, Default = opt.Default == true}
	function el:Set(v, silent)
		v = v == true
		local changed = v ~= self.Value
		self.Value = v
		tween(fill, 0.2, {BackgroundTransparency = v and 0 or 1})
		tween(knob, 0.25, {Position = v and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)})
		if changed and not silent then fire(opt.Callback, v) end
	end
	function el:Reset() self:Set(self.Default) end

	row.MouseButton1Click:Connect(function() el:Set(not el.Value) end)
	el:Set(el.Default, true)
	if opt.Feature then table.insert(FeatureElements, el) end
	return el
end

-- Slider({Name, Min, Max, Step, Default, Suffix, Callback(number), Feature})
function Section:Slider(opt)
	local min, max, step = opt.Min or 0, opt.Max or 100, opt.Step or 1
	local suffix = opt.Suffix or ""
	local decimals = step < 1 and math.clamp(math.ceil(-math.log10(step) - 1e-9), 1, 3) or 0

	local row = self:_row(52)
	label(row, opt.Name, 13, W.R, "Text", {Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -110, 0, 20), TextTruncate = Enum.TextTruncate.AtEnd})

	local badge = new("TextLabel", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 4), Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, TextSize = 11, Parent = row})
	paint(badge, {BackgroundColor3 = "Track", TextColor3 = "Text"})
	setText(badge, W.B)
	corner(badge, 10)
	stroke(badge, "Stroke", "StrokeT")
	padding(badge, 0, 8, 0, 8)

	local track = new("Frame", {Position = UDim2.new(0, 14, 0, 36), Size = UDim2.new(1, -28, 0, 4), Parent = row})
	paint(track, {BackgroundColor3 = "Track"})
	corner(track, 2)
	local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, Parent = track})
	corner(fill, 2)
	accentGradient(fill)
	local knob = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(14, 14), ZIndex = 2, Parent = track})
	paint(knob, {BackgroundColor3 = "Knob"})
	corner(knob, 8)
	stroke(knob, "Accent", 0, 2.5)

	local function format(v)
		if decimals > 0 then return string.format("%." .. decimals .. "f", v) .. suffix end
		return tostring(math.floor(v + 0.5)) .. suffix
	end

	local el = {Value = opt.Default or min, Default = opt.Default or min}
	function el:Set(v, silent)
		v = math.clamp(v, min, max)
		v = math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max)
		local changed = v ~= self.Value
		self.Value = v
		local a = (max > min) and (v - min) / (max - min) or 0
		tween(fill, 0.08, {Size = UDim2.fromScale(a, 1)})
		tween(knob, 0.08, {Position = UDim2.fromScale(a, 0.5)})
		badge.Text = format(v)
		if changed and not silent then fire(opt.Callback, v) end
	end
	function el:Reset() self:Set(self.Default) end

	local hit = new("TextButton", {Text = "", BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 26), Size = UDim2.new(1, -16, 0, 22), Parent = row})
	local dragging = false
	local function update(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		el:Set(min + (max - min) * a)
	end
	hit.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			update(input.Position.X)
			tween(knob, 0.15, {Size = UDim2.fromOffset(17, 17)})
		end
	end)
	connect(UserInputService.InputChanged, function(input)
		if dragging and isMove(input) then update(input.Position.X) end
	end)
	connect(UserInputService.InputEnded, function(input)
		if dragging and isPress(input) then
			dragging = false
			tween(knob, 0.15, {Size = UDim2.fromOffset(14, 14)})
		end
	end)

	el:Set(el.Default, true)
	if opt.Feature then table.insert(FeatureElements, el) end
	return el
end

local function makeButton(parent, opt)
